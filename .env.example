# RemodelaUSA — Variables de entorno (copia a .env en local o configúralas en el hosting)

# Token de acceso al panel de administración (/admin). Mínimo 8 caracteres.
ADMIN_TOKEN=remodelausa-admin

# URL pública del sitio: se usa en los correos (enlace al portal del contratista)
PUBLIC_URL=http://localhost:7100

# Correos transaccionales reales vía Resend (https://resend.com, 100/día gratis).
# Sin esta clave los correos se guardan en la bandeja interna de /admin.
RESEND_API_KEY=
# Remitente verificado en Resend
RESEND_FROM=

# Cobro real de comisiones vía Stripe (https://stripe.com).
# Sin esta clave el cobro funciona en modo demo.
STRIPE_SECRET_KEY=

# Carpeta de datos (SQLite y fotos subidas). En Render/Railway apunta al disco persistente.
DATA_DIR=

# Correo que recibe el aviso de cada nuevo lead
OWNER_EMAIL=owner@remodelausa.com
