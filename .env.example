# RemodelaUSA — Variables de entorno (copia a .env en local o configúralas en el hosting)

# Token de acceso al panel de administración (/admin). Mínimo 8 caracteres.
# SIN VALOR POR DEFECTO (fail closed): sin ADMIN_TOKEN el admin NO funciona
# (503). NUNCA uses 'remodelausa-admin' — esa clave vieja ya no sirve y debe
# ROTARSE en Render si alguna vez se compartió o se publicó.
ADMIN_TOKEN=

# URL pública del sitio: se usa en los correos (enlaces de baja y al portal)
PUBLIC_URL=http://localhost:7100

# Correos transaccionales reales vía Resend (https://resend.com, 100/día gratis).
# Sin esta clave los correos se guardan en la bandeja interna de /admin.
RESEND_API_KEY=
# Remitente de los correos (CAN-SPAM). Debe ser un remitente VERIFICADO en
# Resend: verifica tu dominio en Resend (Domains) y pon aquí p. ej.
# hello@remodelausa.com. Sin dominio verificado, Resend rechaza el envío
# (o solo permite el remitente de prueba onboarding@resend.dev).
FROM_EMAIL=
# Remitente legado (compatibilidad): si FROM_EMAIL está vacío se usa este.
RESEND_FROM=

# Dirección postal física del dueño (CAN-SPAM: pie obligatorio de cada correo).
# NO hay valor inventado: si está vacía, el pie del correo dice claramente
# que falta configurarla. Pon aquí la dirección postal REAL, p. ej.:
# 123 Main St, Kansas City, MO 64106, USA
OWNER_POSTAL_ADDRESS=

# Cobro real de comisiones vía Stripe (https://stripe.com).
# Sin esta clave el cobro funciona en modo demo.
STRIPE_SECRET_KEY=
# Secreto para verificar la firma del webhook de Stripe
# (Dashboard de Stripe → Developers → Webhooks → endpoint /api/billing/webhook).
# Sin este secreto el webhook rechaza todos los eventos: el cobro real
# necesita AMBAS claves (STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET).
STRIPE_WEBHOOK_SECRET=

# Carpeta de datos (SQLite y fotos subidas). En Render/Railway apunta al disco persistente.
DATA_DIR=

# Correo que recibe el aviso de cada nuevo lead
OWNER_EMAIL=owner@remodelausa.com
